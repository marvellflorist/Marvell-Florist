# ---------------------------------------------------------------------------
# Marvell Florist — server-side environment variables
#
# These are read ONLY by Netlify Functions (netlify/functions/*).
# Nothing in this file is ever bundled into browser JavaScript.
#
# Local dev:  copy to .env (already gitignored) and run `npm run dev`, which
#             is `netlify dev` on http://localhost:8888 — the canonical local
#             environment and the only one that runs these functions at all.
#             `npm run doctor` reports what is wired up without printing a
#             single value. A static server (Live Server, scripts/dev-server)
#             cannot exercise anything in this file.
# Production: set each value in Netlify > Site settings > Environment variables.
#
# TWO VALUES MUST DIFFER BETWEEN LOCAL AND PRODUCTION:
#   SITE_ORIGIN    http://localhost:8888   (not the live domain)
#   BREVO_LIST_ID  your localhost test list (not the real audience)
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Service role key. SERVER ONLY. Never prefix with VITE_/PUBLIC_, never log it.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key, in either format: the legacy JWT, or the newer sb_publishable_...
# key from Settings -> API. Used by the My Marvell sign-in endpoints to call
# Supabase Auth.
#
# Still server-only. Supabase intends this key for clients and it is safe to
# publish, but nothing in this project talks to Supabase from a page, so it
# stays here — and it is NOT named VITE_*, because that prefix means "bundle
# this into the browser" and there is no browser bundle to put it in.
#
# Without this, My Marvell reports itself unavailable and the site runs as it
# always has — guests can still order, and orders can still be tracked.
SUPABASE_ANON_KEY=

# --- Brevo (newsletter) ---------------------------------------------------
# The live key exists only in the Netlify Production context. Without it the
# newsletter endpoint returns a friendly "not ready" message instead of failing.
BREVO_API_KEY=
# The list every signup is written to.
#
# 3 is the real "Marvell Newsletter" audience — correct in Netlify, wrong in a
# local .env. Make a separate list for localhost (Brevo > Contacts > Lists >
# Create a list, e.g. "Marvell Newsletter — LOCAL TEST") and put ITS id here,
# so development signups never land in the real audience or re-trigger a
# production automation.
#
# Brevo contacts are global while lists are only groupings, so subscribing a
# real person's address locally still rewrites that contact's attributes. Use
# throwaway addresses for local testing (you+local1@gmail.com and friends).
BREVO_LIST_ID=3
# Optional: separate list for WhatsApp-consented contacts. Leave blank to skip.
BREVO_WHATSAPP_LIST_ID=
# Optional: the name of a Brevo TEXT attribute holding the salutation (MR/MRS/MX)
# collected by the signup dialog. Leave blank unless the attribute exists —
# Brevo refuses a whole contact for one attribute it does not know, and a
# salutation is not worth losing a subscription over. The choice is recorded in
# newsletter_events either way.
BREVO_TITLE_ATTRIBUTE=

# --- iPaymu API v2 (SANDBOX ONLY) -----------------------------------------
# Obtain both values from the separate sandbox dashboard at sandbox.ipaymu.com.
# They are server-side secrets and must have Netlify's Functions scope only.
# Leave either blank to keep checkout in its "payments not yet live" state.
IPAYMU_VA=
IPAYMU_API_KEY=
# The application accepts only "sandbox". Any other value disables payments.
# Production is intentionally unsupported until static outbound IP hosting exists.
IPAYMU_ENVIRONMENT=sandbox

# --- Email identity -------------------------------------------------------
# All three mailboxes exist and are verified; Brevo domain authentication and
# the branded subdomain are configured.
#
# Campaigns and brand communication.
BREVO_NEWSLETTER_SENDER=info@marvellflorist.com
# Customer receipts, order-status messages, and staff transactional mail.
BREVO_ORDER_SENDER=orders@marvellflorist.com
# My Marvell sign-in codes. Transactional, and deliberately not the list's
# sender identity: a sign-in code is not marketing and must never look like it.
BREVO_ACCOUNT_SENDER=info@marvellflorist.com
# Inquiries, consultations and fresh-flower requests.
MARVELL_INQUIRY_EMAIL=hello@marvellflorist.com

# --- Placeholder shop -----------------------------------------------------
# Serves invented prices and stock from content/placeholder-commerce.json so
# the shop can be reviewed before Supabase exists. The site shows a visible
# "Preview" notice whenever it is on.
#
# Ignored (forced off) if SUPABASE_URL is set, or if IPAYMU_ENVIRONMENT is not
# sandbox. Leave it false on the production site.
SHOP_PLACEHOLDER_MODE=false

# --- Mother's Day commerce prototype (DEVELOPMENT ONLY) -------------------
# Merges content/_dev-mothers-day-commerce.json into the catalogue so the
# dormant Mother's Day collection can be carried from Featured to the cart.
# Prices are copied from content/featured.json; stock figures are invented.
#
# Leave this false. It is forced off outside the iPaymu sandbox environment, the
# file it reads is excluded from the deploy, and the browser still only shows
# the collection with ?commerce-test=1. Delete both once real October 2026
# inventory is live.
MARVELL_COMMERCE_TEST=false

# --- Commerce behaviour ---------------------------------------------------
# How long a pending order holds its stock before the reservation is released.
RESERVATION_TTL_MINUTES=30
# How far back the scheduled status check looks for known iPaymu transactions.
PAYMENT_RECONCILE_DAYS=30
# Flat delivery fee in rupiah shown at checkout (0 = quote on confirmation).
DELIVERY_FEE_IDR=0
# Public site origin. Used to build the My Marvell sign-in link, the Google
# PKCE callback and payment return URLs — so it is not cosmetic, and a wrong
# value sends a real customer's sign-in link to the wrong host.
#
# LOCAL: http://localhost:8888
#   An http://localhost or http://127.0.0.1 origin is also the one case where
#   the session cookies drop their Secure flag, because Safari will not store
#   a Secure cookie from a plain-http origin and sign-in would silently fail.
#   Any other origin keeps Secure. See netlify/functions/_lib/accounts.mjs.
SITE_ORIGIN=https://marvellflorist.com

# --- Separate Marvell Admin site -------------------------------------------
# Set on both sites: staff links in public webhook emails and exact Origin
# checks / host-only cookies on the separate admin site.
ADMIN_SITE_ORIGIN=https://admin.marvellflorist.com
# Optional fallback test mailbox while active notifying staff are configured.
# The outbox records an unconfigured recipient if this is blank.
MARVELL_ADMIN_ALERT_EMAIL=
